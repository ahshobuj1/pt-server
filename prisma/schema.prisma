generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  EMPLOYER
  CANDIDATE
}

enum QuestionType {
  CHECKBOX
  RADIO
  TEXT
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  role     UserRole
  exams    Exam[]
  attempts Attempt[]
}

model Exam {
  id              String     @id @default(uuid())
  title           String
  totalCandidates Int
  totalSlots      Int
  questionSets    Int
  startTime       DateTime
  endTime         DateTime
  duration        Int
  employerId      String
  employer        User       @relation(fields: [employerId], references: [id])
  questions       Question[]
  attempts        Attempt[]
}

model Question {
  id            String       @id @default(uuid())
  examId        String
  exam          Exam         @relation(fields: [examId], references: [id])
  questionTitle String
  type          QuestionType
  options       String[]
  correctAnswer String
}

model Attempt {
  id                  String   @id @default(uuid())
  candidateId         String
  candidate           User     @relation(fields: [candidateId], references: [id])
  examId              String
  exam                Exam     @relation(fields: [examId], references: [id])
  score               Int
  tabSwitchCount      Int
  fullscreenExitCount Int
  isSubmitted         Boolean
  createdAt           DateTime @default(now())
}
